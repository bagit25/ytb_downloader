# Copy to .env on the server (deploy/setup.sh does it for you) and adjust.
APP_NAME=Tubeget
DOWNLOAD_DIR=/tmp/ytapp
FILE_TTL=900
MAX_DURATION=3600
MAX_CONCURRENT=2
MAX_QUEUE=10
RATE_LIMIT=15
RATE_WINDOW=600
SHORT_SECONDS=60

# Only if YouTube blocks the server ("Sign in to confirm you're not a bot"):
# COOKIES_FILE=/home/ubuntu/ytb_downloader/cookies.txt
# PROXY=http://user:pass@host:port
